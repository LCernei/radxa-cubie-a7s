---
# Copy to cubie.yml (not in git) and fill in.
# Their GitHub keys are added; keys already on the board stay. Password login is switched off,
# so on a fresh image one of them must hold the key of the laptop that runs Ansible.
base_timezone: <Region/City> # e.g. Europe/Berlin, see timedatectl list-timezones

# GitHub users whose public keys may log in.
base_github_users:
  - <user1>
  - <user2>
